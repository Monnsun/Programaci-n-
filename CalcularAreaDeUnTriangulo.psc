# Calcular el área de un triángulo

print("Por favor ingrese los datos a continuacion para conocer el Area de cualquier triangulo")

print("Ingrese la Base (cm)")
base = float(input())

print("Ingrese la Altura (cm)")
altura = float(input())

area = (base * altura) / 2

print("El area del triangulo es:", area, "cm^2")