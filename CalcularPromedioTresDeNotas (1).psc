# Calcular el promedio de tres notas

print("Ingrese la nota de la materia 1, 2 y 3 (una por una)")

print("Nota de la materia 1")
m1 = float(input())

print("Nota de la materia 2")
m2 = float(input())

print("Nota de la materia 3")
m3 = float(input())

promedio = (m1 + m2 + m3) / 3

print("Su promedio es", promedio)